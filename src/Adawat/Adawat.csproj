<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The UI is built in C# code (no XAML), so the project only needs the
    Windows Desktop framework reference and compiles on any OS.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Adawat</AssemblyName>
    <RootNamespace>Adawat</RootNamespace>
    <ApplicationIcon>Assets\adawat.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.0</Version>
    <Product>Adawat</Product>
    <Company>Adawat</Company>
    <Copyright>Adawat</Copyright>
    <Description>Adawat - Windows toolkit: translator, text from screen and touchpad gestures</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\adawat.ico" LogicalName="Adawat.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Adawat.Tests" />
  </ItemGroup>

</Project>
